# ─────────────────────────────────────────────────────────────
# Gokul's Workspace — environment variables
# Copy to `.env.local` and fill in for production (Supabase) mode.
# The app runs fully in DEMO mode with seeded local data if these
# are left unset.
# ─────────────────────────────────────────────────────────────

# Supabase (Database, Auth, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google SSO is configured inside the Supabase dashboard
# (Authentication → Providers → Google). No extra vars needed here.

# Restrict sign-in to your company Google domain (e.g. "yourcompany.com").
# Anyone signing in with a different domain is rejected. Leave blank to allow
# any Google account.
ALLOWED_EMAIL_DOMAIN=

# Resend — transactional + notification emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="Gokul's Workspace <workspace@yourdomain.com>"

# Anthropic (optional) — upgrades the heuristic AI helpers
# (request validator / priority / effort / intake score) to Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Optional Slack incoming webhook for notifications
SLACK_WEBHOOK_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
